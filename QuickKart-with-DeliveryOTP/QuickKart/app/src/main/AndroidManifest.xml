<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.QuickKart"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickKart.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.MainActivity" android:exported="false" />
        <activity android:name=".activities.ProductListActivity" android:exported="false" />
        <activity android:name=".activities.ProductDetailActivity" android:exported="false" />
        <activity android:name=".activities.CheckoutActivity" android:exported="false" />
        <activity android:name=".activities.EditProfileActivity" android:exported="false" />
        <activity android:name=".activities.ChangePasswordActivity" android:exported="false" />
        <activity android:name=".activities.OrderDetailActivity" android:exported="false" />

        <activity android:name=".admin.AdminLoginActivity" android:exported="false" />
        <activity android:name=".admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".admin.AdminCategoryActivity" android:exported="false" />
        <activity android:name=".admin.AdminProductActivity" android:exported="false" />
        <activity android:name=".admin.AdminOrderActivity" android:exported="false" />
        <activity android:name=".admin.AdminOrderDetailActivity" android:exported="false" />
        <activity android:name=".admin.AdminUserActivity" android:exported="false" />
        <activity android:name=".admin.AdminSettingActivity" android:exported="false" />
        <activity android:name=".delivery.DeliveryLoginActivity" android:exported="false" />
        <activity android:name=".delivery.DeliveryOrdersActivity" android:exported="false" />
        <activity android:name=".delivery.DeliveryOtpActivity" android:exported="false" />

    </application>

</manifest>
